{
  "manifest_version": 3,
  "name": "Astik Helper — myAadhaar Form",
  "version": "8.0.0",
  "description": "Astik jaisa UIDAI form mode switch — DOB mode se Mobile/Email mode",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://myaadhaar.uidai.gov.in/*",
    "https://*.uidai.gov.in/*"
  ],
  "action": {
    "default_title": "Astik Helper — Click to toggle DOB hide mode",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://myaadhaar.uidai.gov.in/*",
        "https://*.uidai.gov.in/*"
      ],
      "js": ["uidai-engine.js", "core-logic.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["core-logic.js"],
      "matches": ["https://*.uidai.gov.in/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
