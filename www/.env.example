# Telegram — @BotFather se token lo
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Sirf tumhara chat id ( @userinfobot se /start )
TELEGRAM_ALLOWED_CHAT_IDS=8432393497

# Owner — /free /lock /approve
TELEGRAM_OWNER_ID=8432393497

# Route — auto = pehli baar proxy scan, phir cookies forever | direct = bina proxy
UIDAI_PROXY=auto
# Pehli proxy 3 try (benchmark fastest — auto update):
# UIDAI_PRIMARY_PROXY=http://14.143.222.113:57738
UIDAI_PROXY_TRIES=3
UIDAI_PROXY_TRIAL_SEC=30
UIDAI_PROXY_CACHE=0
UIDAI_INDIAN_PROXY_AUTO=1
# Apne proxy comma se: UIDAI_PROXY_LIST=http://ip:port,http://ip2:port

# Default form (optional)
UIDAI_NAME=KAMAR JAHAN
UIDAI_MOBILE=7651892956

# 24h session — page open rakho (default 24 hours)
UIDAI_SESSION_HOURS=24
UIDAI_KEEPALIVE_MIN=10

# 2-OTP PDF flow — HTTP (foreign VPS): auto | http | playwright
UIDAI_HTTP_MODE=auto
UIDAI_HTTP_TIMEOUT=45
# Auto audio captcha (needs: pip install openai-whisper pydub + ffmpeg)
# UIDAI_WHISPER=1
# UIDAI_WHISPER_MODEL=base

# Captcha bypass (default on) — captcha:null + OCR auto
UIDAI_CAPTCHA_BYPASS=1
UIDAI_OCR=1

# Baked session — code me uidai_baked_session.json (proxy se capture, sab sessions isolated)
UIDAI_BAKED_SESSION=1

# Cookies — portal seed + disk pe save (uidai_cookies.json)
UIDAI_COOKIE_SEED=1
UIDAI_COOKIE_PERSIST=1
UIDAI_COOKIE_TIMEOUT=25
UIDAI_COOKIE_MAX_AGE_HOURS=0

# Speed — UIDAI_FAST=1 skips 30s proxy scan (default off)
UIDAI_FAST=0
UIDAI_AUTO_CAPTCHA=0
