# Telegram — get token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Your chat id ( @userinfobot /start )
TELEGRAM_ALLOWED_CHAT_IDS=8432393497

# Owner — /free /lock /approve
TELEGRAM_OWNER_ID=8432393497

# Default form (optional)
UIDAI_NAME=KAMAR JAHAN
UIDAI_MOBILE=7651892956

# 24h session — keep page open (default 24 hours)
UIDAI_SESSION_HOURS=24
UIDAI_KEEPALIVE_MIN=10

# PDF flow — HTTP mode (Indian VPS direct)
UIDAI_HTTP_MODE=auto
UIDAI_HTTP_TIMEOUT=45
UIDAI_PDF_HTTP=1
# Real DOB for /pdf (DD/MM/YYYY). Set 1 to skip DOB (dob:null legacy)
# UIDAI_DOB_BYPASS=0
# /pdf captcha: auto = HTTP then browser fallback | http = API only | browser = page only
UIDAI_PDF_CAPTCHA=auto
# PDF open — NAME4 + birth year brute (default 1920–2020)
# UIDAI_PDF_YEAR_MIN=1920
# UIDAI_PDF_YEAR_MAX=2020
# Optional proxy (Indian residential) if VPS IP blocked: UIDAI_PROXY=http://host:port
# /pdf captcha uses Playwright browser image (same as /open) — Chromium required
# Whisper kept for legacy HTTP tools only (not used by /pdf captcha)
UIDAI_WHISPER=0
UIDAI_WHISPER_AUTO=0

# Captcha — manual entry only (user types from image/audio)
UIDAI_CAPTCHA_BYPASS=0
UIDAI_OCR=0
UIDAI_AUTO_CAPTCHA=0

# Cookies — portal seed + disk save (uidai_cookies.json)
UIDAI_COOKIE_SEED=1
UIDAI_COOKIE_PERSIST=1
UIDAI_COOKIE_TIMEOUT=25
UIDAI_COOKIE_MAX_AGE_HOURS=0

# Speed — UIDAI_FAST=1: HTTP-first captcha, tight timeouts, debounced UI (default ON)
UIDAI_FAST=1

# Browser pool warm on startup (1 = instant phase-1 captcha when FAST=1)
UIDAI_POOL_WARM=1

# aadhar.py timeouts + auto-retry (Indian VPS direct)
AADHAR_TIMEOUT=12
AADHAR_CONNECT_TIMEOUT=6
AADHAR_POST_RETRIES=3
AADHAR_STEP_RETRIES=2
# UIDAI_PROXY=http://host:port
