# Telegram — @BotFather se token lo
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Sirf tumhara chat id ( @userinfobot se /start )
TELEGRAM_ALLOWED_CHAT_IDS=123456789

# Owner — /free /lock /approve (default: pehla ALLOWED_CHAT_ID)
