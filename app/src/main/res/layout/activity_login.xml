<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rebel_bg"
    android:padding="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rebel Panel"
            android:textColor="@color/rebel_accent"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:text="Secure login · @Rebelpanelbot /genkey"
            android:textColor="#99FFFFFF"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/login_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:hint="RBL-XXXXXX-XXXXXX"
            android:inputType="textCapCharacters"
            android:letterSpacing="0.08"
            android:maxLength="32"
            android:padding="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#66FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/login_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFF4466"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/login_lock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFF9500"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/login_submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/rebel_accent"
            android:text="Unlock"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
