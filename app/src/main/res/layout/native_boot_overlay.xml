<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nativeBootRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050508"
    android:clickable="true"
    android:focusable="true">

    <View
        android:id="@+id/bootOrb1"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-80dp"
        android:layout_marginTop="-60dp"
        android:alpha="0.35"
        android:background="@drawable/boot_orb_cyan" />

    <View
        android:id="@+id/bootOrb2"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-50dp"
        android:layout_marginBottom="-40dp"
        android:alpha="0.28"
        android:background="@drawable/boot_orb_magenta" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp">

            <View
                android:id="@+id/bootRing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/boot_ring" />

            <ImageView
                android:id="@+id/bootAvatar"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_rebel_launcher" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:letterSpacing="0.12"
            android:text="REBEL"
            android:textColor="#00F5FF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.35"
            android:text="PANEL"
            android:textColor="#FF00FF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/bootStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.08"
            android:text="INITIALIZING"
            android:textColor="#6A7A8A"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/bootProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="200dp"
            android:layout_height="3dp"
            android:layout_marginTop="16dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/boot_progress" />

        <TextView
            android:id="@+id/bootPct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="0%"
            android:textColor="#00F5FF"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
